{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/carte",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/etat-de-la-france/immigration",
      "destination": "/etat-de-la-france/population",
      "permanent": true
    },
    {
      "source": "/en/etat-de-la-france/immigration",
      "destination": "/en/etat-de-la-france/population",
      "permanent": true
    }
  ]
}
